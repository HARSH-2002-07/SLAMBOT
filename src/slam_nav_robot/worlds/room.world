<?xml version="1.0"?>
<sdf version="1.6">
  <world name="slam_room">

    <!-- Physics -->
    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
    </physics>

    <!-- Lighting -->
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- ═══ OUTER WALLS ═══ -->
    <!-- North wall -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 4 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>8 0.1 1</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>8 0.1 1</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient></material></visual>
      </link>
    </model>

    <!-- South wall -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -4 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>8 0.1 1</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>8 0.1 1</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient></material></visual>
      </link>
    </model>

    <!-- East wall -->
    <model name="wall_east">
      <static>true</static>
      <pose>4 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.1 8 1</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.1 8 1</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient></material></visual>
      </link>
    </model>

    <!-- West wall -->
    <model name="wall_west">
      <static>true</static>
      <pose>-4 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.1 8 1</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.1 8 1</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient></material></visual>
      </link>
    </model>

    <!-- ═══ INNER OBSTACLES ═══ -->
    <!-- Box obstacle 1 -->
    <model name="box_1">
      <static>true</static>
      <pose>1.5 1.5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><ambient>0.8 0.3 0.2 1</ambient></material></visual>
      </link>
    </model>

    <!-- Box obstacle 2 -->
    <model name="box_2">
      <static>true</static>
      <pose>-1.5 -1.0 0.25 0 0 0.7</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.6 0.3 0.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.6 0.3 0.5</size></box></geometry>
          <material><ambient>0.2 0.6 0.3 1</ambient></material></visual>
      </link>
    </model>

    <!-- Cylinder obstacle -->
    <model name="cylinder_1">
      <static>true</static>
      <pose>2.0 -1.5 0.3 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.2</radius><length>0.6</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.2</radius><length>0.6</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.8 1</ambient></material></visual>
      </link>
    </model>

    <!-- Internal partition wall (L-shaped room feel) -->
    <model name="partition_1">
      <static>true</static>
      <pose>0 1.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>2.5 0.1 1</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>2.5 0.1 1</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient></material></visual>
      </link>
    </model>

    <model name="partition_2">
      <static>true</static>
      <pose>-2.0 -2.0 0.5 0 0 1.5708</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>2.0 0.1 1</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>2.0 0.1 1</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient></material></visual>
      </link>
    </model>

  </world>
</sdf>